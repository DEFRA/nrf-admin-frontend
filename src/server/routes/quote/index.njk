{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block beforeContent %}
  {# beforeContent sits outside <main>, so the link needs its own landmark —
     see frontend's back-link component for the same pattern #}
  <nav>
    {{ govukBackLink({
      text: "Back to quotes",
      href: "/"
    }) }}
  </nav>
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if errorMessage %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: errorMessage }]
        }) }}
      {% else %}
        {% set journeyLabels = { quote: "Quote journey", request_to_use: "Request to use journey" } %}

        {% set detailsPanel %}
          {{ govukSummaryList({
            rows: [
              {
                key: { text: "Quote created" },
                value: { text: quote.createdAt | formatDateTime }
              } if quote.createdAt,
              {
                key: { text: "Planning application type" },
                value: { text: quote.planningType }
              } if quote.planningType,
              {
                key: { text: "Boundary type" },
                value: { text: quote.boundary.userInputType ~ (" (" ~ quote.boundary.filename ~ ")" if quote.boundary.userInputType === "upload" and quote.boundary.filename else "") }
              } if quote.boundary and quote.boundary.userInputType,
              {
                key: { text: "Commitment certificate created at" },
                value: { text: (quote.commitmentCertificateCreatedAt | formatDateTime) if quote.commitmentCertificateCreatedAt else "Not created" }
              }
            ]
          }) }}
        {% endset %}

        {% set quotePanel %}

          {% if not quote.hasLevyHistory %}
            <p class="govuk-body">No levy calculations have been recorded for this quote.</p>
          {% endif %}
          {% for edp in quote.edps %}
            {% if edp.levyHistory and edp.levyHistory.length %}
              {% set historyRows = [] %}
              {% for calculation in edp.levyHistory %}
                {% set historyRows = (historyRows.push([
                  { text: calculation.calculatedAt | formatDateTime },
                  { text: journeyLabels[calculation.journey] },
                  { text: calculation.units, format: "numeric" },
                  { text: calculation.originalBaseChargePerUnit | formatCurrencyPrecise, format: "numeric" },
                  { text: calculation.baseChargePerUnit | formatCurrencyPrecise, format: "numeric" },
                  { text: calculation.originalBaseAmount | formatCurrency({ hideZeroPence: true }), format: "numeric" },
                  { text: calculation.provisionalAmount | formatCurrency({ hideZeroPence: true }), format: "numeric" },
                  { text: calculation.inflationAdjustedAmount | formatCurrency({ hideZeroPence: true }), format: "numeric" },
                  { text: calculation.modelVersion, format: "numeric" }
                ]), historyRows) %}
              {% endfor %}
              {{ govukTable({
                caption: "Levy calculation history",
                captionClasses: "govuk-table__caption--m",
                head: [
                  { text: "Calculated" },
                  { text: "Journey" },
                  { text: "Units", format: "numeric" },
                  { text: "Original base charge per unit", format: "numeric" },
                  { text: "Base charge per unit", format: "numeric" },
                  { text: "Original base amount", format: "numeric" },
                  { text: "Provisional amount", format: "numeric" },
                  { text: "Inflation adjusted amount", format: "numeric" },
                  { text: "Model version", format: "numeric" }
                ],
                rows: historyRows
              }) }}
            {% endif %}
          {% endfor %}
        {% endset %}

        {% set emailsPanel %}
          {% if quote.emailNotifications and quote.emailNotifications.length %}
            {% set emailRows = [] %}
            {% for notification in quote.emailNotifications %}
              {% set notifyStatusHtml %}
                {{ appNotifyStatusTag({ statusTag: notification.statusTag }) }}
                {% if notification.notifyStatusUrl %}
                  <a class="govuk-link govuk-!-margin-left-2" href="{{ notification.notifyStatusUrl }}">(view email)</a>
                {% endif %}
              {% endset %}
              {% set emailRows = (emailRows.push([
                { text: (notification.sendRequestAt | formatDateTime) if notification.sendRequestAt else "–" },
                { text: quote.email.address },
                { text: notification.emailType },
                { html: notifyStatusHtml },
                { text: notification.sendRetryCount, format: "numeric" }
              ]), emailRows) %}
            {% endfor %}
            {{ govukTable({
              caption: "Emails sent to user",
              captionClasses: "govuk-table__caption--m",
              head: [
                { text: "Send requested" },
                { text: "Email address" },
                { text: "Email type" },
                { html: "Notify send status (<a class=\"govuk-link\" href=\"https://docs.notifications.service.gov.uk/node.html#email-status-descriptions\">reference</a>)" },
                { text: "Retry count", format: "numeric" }
              ],
              rows: emailRows
            }) }}
          {% else %}
            <h2 class="govuk-heading-m">Emails sent to user</h2>
            <p class="govuk-body">No email has been sent for this quote. The levy calculation did not complete.</p>
          {% endif %}
        {% endset %}

        {% set edpsPanel %}
          {% if quote.edps and quote.edps.length %}
            {% for edp in quote.edps %}
              <h2 class="govuk-heading-s">{{ edp.edpName }}</h2>
              <p class="govuk-body">EDP start date: {{ edp.edpStartDate | govukDate }}</p>

              {% if edp.catchments and edp.catchments.length %}
                <h3 class="govuk-heading-s">Catchments</h3>
                <ul class="govuk-list govuk-list--bullet">
                  {% for catchment in edp.catchments %}
                    <li>{{ catchment.label }} — {{ catchment.catchmentOverlapPercentage }}% overlap</li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% endfor %}
          {% else %}
            <p class="govuk-body">No EDPs have been recorded for this quote.</p>
          {% endif %}
        {% endset %}

        {{ govukTabs({
          items: [
            { label: "Details & dates", id: "details-and-dates", panel: { html: detailsPanel } },
            { label: "Levy", id: "quote", panel: { html: quotePanel } },
            { label: "Emails sent", id: "emails-sent", panel: { html: emailsPanel } },
            { label: "EDPs", id: "edps", panel: { html: edpsPanel } }
          ]
        }) }}

        {% if quote.deleteEligible %}
          {{ govukButton({
            text: "Delete quote",
            href: "/quote/" + quote.reference + "/delete",
            classes: "govuk-button--warning"
          }) }}
        {% else %}
          {{ govukInsetText({
            text: "This quote cannot be deleted because it was not created with an approved internal email address."
          }) }}
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}
