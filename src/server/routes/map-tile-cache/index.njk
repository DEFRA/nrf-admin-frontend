{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {% if notification == 'tile-cache-cleared' %}
    {% set tileCount = clearedCount | int %}
    {{ govukNotificationBanner({
      type: 'success',
      text: 'Map tile cache cleared successfully. ' + tileCount + ' tile' + ('s' if tileCount != 1 else '') + ' removed.'
    }) }}
  {% elif notification == 'tile-cache-error' %}
    {{ govukNotificationBanner({
      titleText: 'There is a problem',
      html: '<p class="govuk-body">Failed to clear the map tile cache. Check the logs for details.</p>'
    }) }}
  {% endif %}

  {{ appHeading({
    text: heading
  }) }}

  <form method="post" action="/map-tile-cache/clear">
    {{ govukButton({
      text: 'Clear map tile cache',
      classes: 'govuk-button--secondary'
    }) }}
  </form>
{% endblock %}
