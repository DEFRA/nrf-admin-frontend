{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block beforeContent %}
  <nav>
    {{ govukBackLink({
      text: "Back to inflation index",
      href: backHref
    }) }}
  </nav>
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  {% set jiraTicketHtml %}
    {% if jiraTicketUrl %}
      <a class="govuk-link" href="{{ jiraTicketUrl }}" target="_blank" rel="noopener noreferrer">{{ inflationIndex.jiraTicket }} (opens in new tab)</a>
    {% else %}
      –
    {% endif %}
  {% endset %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      {{ govukSummaryList({
        rows: [
          { key: { text: "Charging year" }, value: { text: inflationIndex.chargingYear } },
          { key: { text: "RICS CIL Index" }, value: { text: inflationIndex.cilIndex } },
          { key: { text: "Factor" }, value: { text: inflationIndex.indexFactor.toFixed(4) } },
          { key: { text: "Effective from" }, value: { text: inflationIndex.effectiveFrom | govukDate } },
          { key: { text: "Created" }, value: { text: inflationIndex.createdAt | formatUkDateTime } },
          { key: { text: "Requestor" }, value: { text: inflationIndex.requestor or "–" } },
          { key: { text: "Jira ticket" }, value: { html: jiraTicketHtml } },
          { key: { text: "Comment" }, value: { text: inflationIndex.comment } },
          { key: { text: "Saved by" }, value: { text: inflationIndex.staffFullName } },
          { key: { text: "Saved by (email)" }, value: { text: inflationIndex.staffEmail } },
          { key: { text: "Saved by (Entra ID)" }, value: { text: inflationIndex.staffId } }
        ]
      }) }}
    </div>
  </div>
{% endblock %}
