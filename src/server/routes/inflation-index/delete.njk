{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block beforeContent %}
  <nav>
    {{ govukBackLink({
      text: "Back to inflation index",
      href: backHref
    }) }}
  </nav>
{% endblock %}

{% block pageTitle %}
  {{ "Error: " if errorList.length }}{{ pageTitle }} | {{ serviceName }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      {{ appHeading({
        text: heading
      }) }}

      {{ govukWarningText({
        text: "The inflation index will not apply. The existing inflation index will continue to apply.",
        iconFallbackText: "Warning"
      }) }}

      {{ govukSummaryList({
        rows: [
          { key: { text: "Charging year" }, value: { text: inflationIndex.chargingYear } },
          { key: { text: "RICS CIL Index" }, value: { text: inflationIndex.cilIndex } },
          { key: { text: "Factor" }, value: { text: inflationIndex.indexFactor.toFixed(4) } },
          { key: { text: "Effective from" }, value: { text: inflationIndex.effectiveFrom | govukDate } },
          { key: { text: "Comment" }, value: { text: inflationIndex.comment } }
        ]
      }) }}

      <form method="post" action="{{ formAction }}" novalidate>
        {% include "partials/csrf-token.njk" %}

        {{ govukCharacterCount({
          id: "comment",
          name: "comment",
          label: {
            text: "Comment",
            classes: "govuk-label--m"
          },
          hint: { text: "Say why the inflation index is being deleted. The comment is kept in the change history with your name." },
          maxlength: maxCommentLength,
          value: values.comment,
          errorMessage: { text: errors.comment } if errors.comment
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Yes, delete this inflation index",
            classes: "govuk-button--warning"
          }) }}
          <a class="govuk-link" href="{{ backHref }}">Cancel <span class="govuk-visually-hidden">deleting this inflation index</span></a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
