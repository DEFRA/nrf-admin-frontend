{% extends 'layouts/page.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "nrf-admin-frontend"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {% if errorMessage %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: errorMessage }]
        }) }}
      {% elif quotes and quotes.length %}
        {% set tableRows = [] %}
        {% for quote in quotes %}
          {% set edpHtml %}
            {% if quote.edps.length %}
              {% for edp in quote.edps %}
                <h3 class="govuk-heading-s">{{ edp.edpName }}</h3>
                <ul class="govuk-list govuk-list--bullet">
                  <li>Type: {{ edp.edpType }}</li>
                  <li>Levy: {{ edp.levyGbp.min | formatCurrency }}–{{ edp.levyGbp.max | formatCurrency }}</li>
                  {% if edp.impact.nitrogenTotal %}
                    <li>Nitrogen: {{ edp.impact.nitrogenTotal.band.min }}–{{ edp.impact.nitrogenTotal.band.max }} / {{ edp.impact.nitrogenTotal.amount }} {{ edp.impact.nitrogenTotal.unit }}</li>
                  {% endif %}
                  {% if edp.impact.phosphorusTotal %}
                    <li>Phosphorus: {{ edp.impact.phosphorusTotal.band.min }}–{{ edp.impact.phosphorusTotal.band.max }} / {{ edp.impact.phosphorusTotal.amount }} {{ edp.impact.phosphorusTotal.unit }}</li>
                  {% endif %}
                </ul>
              {% endfor %}
            {% else %}
              None
            {% endif %}
          {% endset %}
          {% set tableRows = (tableRows.push([
            { text: quote.reference },
            { text: quote.email.address },
            { text: quote.boundary.userInputType },
            { text: quote.development.types | join(', ') },
            { text: quote.development.residentialBuildingCount },
            { text: quote.development.peopleCount },
            { text: quote.createdAt | govukDate },
            { text: quote.email.sendRequestAt | govukDate },
            { text: quote.wasteWaterTreatmentWorksName or 'Unknown' },
            { text: quote.boundary.filename },
            { html: edpHtml }
          ]), tableRows) %}
        {% endfor %}

        {{ govukTable({
          caption: "All quotes",
          captionClasses: "govuk-table__caption--m",
          head: [
            { text: "Reference" },
            { text: "Email" },
            { text: "Boundary entry type" },
            { text: "Development types" },
            { text: "Residential building count" },
            { text: "Max people count" },
            { text: "Date submitted" },
            { text: "Email send request date" },
            { text: "Waste water treatment works" },
            { text: "Boundary file name" },
            { text: "EDP results" }
          ],
          rows: tableRows
        }) }}
      {% else %}
        <p class="govuk-body">No quotes have been added yet</p>
      {% endif %}

    </div>
  </div>

{% endblock %}
