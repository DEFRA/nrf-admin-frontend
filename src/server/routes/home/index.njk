{% extends 'layouts/page.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  {% if notification == 'tile-cache-cleared' %}
    {% set tileCount = clearedCount | int %}
    {{ govukNotificationBanner({
      type: 'success',
      text: 'Map tile cache cleared successfully. ' + tileCount + ' tile' + ('s' if tileCount != 1 else '') + ' removed.'
    }) }}
  {% elif notification == 'tile-cache-error' %}
    {{ govukNotificationBanner({
      titleText: 'There is a problem',
      html: '<p class="govuk-body">Failed to clear the map tile cache. Check the logs for details.</p>'
    }) }}
  {% elif notification == 'quote-deleted' %}
    {{ govukNotificationBanner({
      type: 'success',
      text: 'Quote ' + deletedReference + ' was deleted.'
    }) }}
  {% elif notification == 'quote-delete-not-eligible' %}
    {{ govukNotificationBanner({
      text: 'This quote cannot be deleted because it was not created with an approved internal email address.'
    }) }}
  {% elif notification == 'quote-delete-error' %}
    {{ govukNotificationBanner({
      titleText: 'There is a problem',
      html: '<p class="govuk-body">Failed to delete the quote. Check the logs for details.</p>'
    }) }}
  {% elif notification == 'quotes-deleted' %}
    {% set deletedQuotesCount = deletedCount | int %}
    {{ govukNotificationBanner({
      type: 'success',
      text: deletedQuotesCount + ' quote' + ('s' if deletedQuotesCount != 1 else '') + ' ' + ('were' if deletedQuotesCount != 1 else 'was') + ' deleted.'
    }) }}
  {% elif notification == 'quotes-delete-partial' %}
    {{ govukNotificationBanner({
      titleText: 'There is a problem',
      html: '<p class="govuk-body">' + (deletedCount | int) + ' of ' + (totalCount | int) + ' selected quotes were deleted. The rest could not be deleted — check the logs for details.</p>'
    }) }}
  {% elif notification == 'quotes-delete-failed' %}
    {{ govukNotificationBanner({
      titleText: 'There is a problem',
      html: '<p class="govuk-body">No quotes were deleted. Check the logs for details.</p>'
    }) }}
  {% elif notification == 'quotes-delete-not-eligible' %}
    {{ govukNotificationBanner({
      text: 'No quotes were deleted because they were not created with an approved internal email address.'
    }) }}
  {% elif notification == 'quotes-bulk-none-selected' %}
    {{ govukNotificationBanner({
      titleText: 'There is a problem',
      html: '<p class="govuk-body">Select at least one quote to delete.</p>'
    }) }}
  {% endif %}

  <form method="post" action="/cache/clear-tile-cache">
    {{ govukButton({
      text: 'Clear map tile cache',
      classes: 'govuk-button--secondary'
    }) }}
  </form>

  {% if errorMessage %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: [{ text: errorMessage }]
    }) }}
  {% elif quotes and quotes.length %}
    {% set hasEligible = quotes | selectattr("deleteEligible") | list | length > 0 %}
    {% set tableRows = [] %}
    {% set tableHead = [] %}
    {% if hasEligible %}
      {% set selectAllHtml %}
        <div class="govuk-checkboxes govuk-checkboxes--small">
          <div class="govuk-checkboxes__item govuk-!-margin-bottom-0">
            <input type="checkbox" class="govuk-checkboxes__input" id="select-all-quotes" data-select-all>
            <label class="govuk-label govuk-checkboxes__label govuk-!-padding-left-0 govuk-!-padding-right-0" for="select-all-quotes">
              <span class="govuk-visually-hidden">Select all eligible quotes</span>
            </label>
          </div>
        </div>
      {% endset %}
      {% set tableHead = (tableHead.push({ html: selectAllHtml }), tableHead) %}
    {% endif %}
    {% set tableHead = (tableHead.push(
      { text: "Date submitted" },
      { text: "Reference" },
      { text: "Planning application type" },
      { text: "Red line boundary" },
      { text: "Housing units" },
      { text: "Email" },
      { text: "Analytics disabled" }
    ), tableHead) %}
    {% for quote in quotes %}
      {% set boundaryHtml %}
        {% if quote.boundary.userInputType === 'upload' and quote.boundary.filename %}
          <abbr title="{{ quote.boundary.filename }}">upload</abbr>
        {% else %}
        {{ quote.boundary.userInputType }}
        {% endif %}
      {% endset %}
      {% set referenceHtml %}
        <a class="govuk-link" href="/quote/{{ quote.reference }}">{{ quote.reference }}</a>
      {% endset %}
      {% set rowCells = [] %}
      {% if hasEligible %}
        {% set selectHtml %}
          {% if quote.deleteEligible %}
            <div class="govuk-checkboxes govuk-checkboxes--small">
              <div class="govuk-checkboxes__item govuk-!-margin-bottom-0">
                <input type="checkbox" class="govuk-checkboxes__input" id="select-{{ quote.reference }}" name="references" value="{{ quote.reference }}" data-bulk-select>
                <label class="govuk-label govuk-checkboxes__label govuk-!-padding-left-0 govuk-!-padding-right-0" for="select-{{ quote.reference }}">
                  <span class="govuk-visually-hidden">Select quote {{ quote.reference }}</span>
                </label>
              </div>
            </div>
          {% endif %}
        {% endset %}
        {% set rowCells = (rowCells.push({ html: selectHtml }), rowCells) %}
      {% endif %}
      {% set tableRows = (tableRows.push(rowCells.concat([
        { text: quote.createdAt | formatDateTime },
        { html: referenceHtml },
        { text: quote.planningType },
        { html: boundaryHtml },
        { text: quote.housingUnits },
        { text: quote.email.address },
        { text: "Yes" if quote.disableAnalyticsAudit else "No" }
      ])), tableRows) %}
    {% endfor %}

    {% if hasEligible %}
      <form method="get" action="/quotes/delete">
    {% endif %}
    {% if hasEligible %}
        {{ govukButton({
          text: "Delete selected quotes",
          classes: "govuk-button--warning"
        }) }}

    {% endif %}

    {{ govukTable({
      caption: quotes.length + " quotes",
      captionClasses: "govuk-table__caption--s",
      classes: "govuk-table--small-text-until-tablet",
      head: tableHead,
      rows: tableRows
    }) }}

    {% if hasEligible %}
      </form>
    {% endif %}
  {% else %}
    <p class="govuk-body">No quotes have been added yet</p>
  {% endif %}

{% endblock %}
