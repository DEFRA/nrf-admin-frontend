{% extends 'layouts/page.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  {% if notification == 'tile-cache-cleared' %}
    {% set tileCount = clearedCount | int %}
    {{ govukNotificationBanner({
      type: 'success',
      text: 'Map tile cache cleared successfully. ' + tileCount + ' tile' + ('s' if tileCount != 1 else '') + ' removed.'
    }) }}
  {% elif notification == 'tile-cache-error' %}
    {{ govukNotificationBanner({
      titleText: 'There is a problem',
      html: '<p class="govuk-body">Failed to clear the map tile cache. Check the logs for details.</p>'
    }) }}
  {% endif %}

  <form method="post" action="/cache/clear-tile-cache">
    {{ govukButton({
      text: 'Clear map tile cache',
      classes: 'govuk-button--secondary'
    }) }}
  </form>

  {% if errorMessage %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: [{ text: errorMessage }]
    }) }}
  {% elif quotes and quotes.length %}
    {% set tableRows = [] %}
    {% for quote in quotes %}
      {% set edpHtml %}
        {% if quote.edps.length %}
          {% for edp in quote.edps %}
            {% set edpDetailsHtml %}
              <ul class="govuk-list govuk-list--bullet">
                <li>Type: {{ edp.edpType }}</li>
                <li>Levy: {{ edp.levyGbp.min | formatCurrency }}–{{ edp.levyGbp.max | formatCurrency }}</li>
                {% if edp.impact.nitrogenTotal %}
                  <li>Nitrogen: {{ edp.impact.nitrogenTotal.band.min }}–{{ edp.impact.nitrogenTotal.band.max }} / {{ edp.impact.nitrogenTotal.amount }} {{ edp.impact.nitrogenTotal.unit }}</li>
                {% endif %}
                {% if edp.impact.phosphorusTotal %}
                  <li>Phosphorus: {{ edp.impact.phosphorusTotal.band.min }}–{{ edp.impact.phosphorusTotal.band.max }} / {{ edp.impact.phosphorusTotal.amount }} {{ edp.impact.phosphorusTotal.unit }}</li>
                {% endif %}
              </ul>
            {% endset %}
            {{ govukDetails({
              summaryText: edp.edpName,
              html: edpDetailsHtml
            }) }}
          {% endfor %}
        {% else %}
          None
        {% endif %}
      {% endset %}
      {% set tableRows = (tableRows.push([
        { text: quote.reference },
        { text: quote.email.address },
        { text: quote.boundary.userInputType },
        { text: quote.development.types | join(', ') },
        { text: quote.development.residentialBuildingCount },
        { text: quote.development.peopleCount },
        { text: quote.createdAt | govukDate },
        { text: quote.email.sendRequestAt | govukDate },
        { html: edpHtml }
      ]), tableRows) %}
    {% endfor %}

    {{ govukTable({
      caption: quotes.length + " quotes",
      captionClasses: "govuk-table__caption--s",
      classes: "govuk-table--small-text-until-tablet",
      head: [
        { text: "Reference" },
        { text: "Email" },
        { text: "Boundary entry type" },
        { text: "Development types" },
        { text: "Residential building count" },
        { text: "Max people count" },
        { text: "Date submitted" },
        { text: "Email send request date" },
        { text: "EDP results" }
      ],
      rows: tableRows
    }) }}
  {% else %}
    <p class="govuk-body">No quotes have been added yet</p>
  {% endif %}

{% endblock %}
