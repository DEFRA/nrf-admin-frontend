git-tag-version=false
save-exact=true
# The defradigital/node(-development) base images disable git-protocol
# dependency fetches by default (npm's allow-git=none). This repo has no
# github: dependency today, but re-allows root-declared git dependencies
# (not transitive ones) for consistency with the sibling nrf-* repos and in
# case one is added later.
allow-git=root
