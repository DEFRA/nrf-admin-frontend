NRF_BACKEND_API_URL=http://localhost:4001

# Service-to-service API key sent on outbound calls to the backend.
# Required in production; may be empty in dev/test.
BACKEND_API_KEY=

# Uploads API (server-enforced bearer auth + cdp-uploader target)
UPLOAD_API_BEARER_TOKEN=local-dev-token
CDP_UPLOADER_URL=http://localhost:7337
CDP_UPLOADER_S3_BUCKET=data_backups
CDP_UPLOADER_S3_PATH_PREFIX=spatial

# S3 access for the file-list endpoint.
# AWS_S3_ENDPOINT is local-dev only - it points at a local emulator
# (floci/localstack on 4566). Leave it unset in production, where the platform's
# IAM role and default endpoint are used.
AWS_REGION=eu-west-2
AWS_S3_ENDPOINT=http://localhost:4566

# Impact-assessor data-sync trigger. DATA_SYNC_TOKEN is the shared secret sent
# as x-data-sync-token; required in production.
NRF_IMPACT_ASSESSOR_API_URL=http://localhost:8085
DATA_SYNC_TOKEN=local-dev-data-sync-token


APP_BASE_URL=http://localhost:3000
OIDC_WELL_KNOWN_CONFIGURATION_URL=https://login.microsoftonline.com/6f504113-6b64-43f2-ade9-242e05780007/v2.0/.well-known/openid-configuration

AZURE_TENANT_ID=6f504113-6b64-43f2-ade9-242e05780007
AZURE_CLIENT_ID=26372ac9-d8f0-4da9-a17e-938eb3161d8e
AZURE_CLIENT_SECRET=your-client-secret-here

# Set to true to use mock federated credentials instead of hitting AWS Cognito
AZURE_FEDERATED_CREDENTIALS_ENABLE_MOCKING=false
AZURE_IDENTITY_POOL_ID=
